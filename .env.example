# Naver API Keys Configuration Template
# 네이버 클라우드 플랫폼(NCP) 또는 네이버 개발자센터 키를 입력하세요.
# 실제 키는 이 파일이 아닌 .env 파일에 입력해야 하며, .env는 gitignore로 관리됩니다.

# 1. 네이버 클라우드 플랫폼 (NCP NAVER API HUB Gateway 방식)
NCP_CLIENT_ID=your_ncp_api_key_id_here
NCP_CLIENT_SECRET=your_ncp_api_secret_key_here

# 2. 네이버 개발자센터 (Open API 방식)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
