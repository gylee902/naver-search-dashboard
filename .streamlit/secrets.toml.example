# Streamlit Community Cloud 배포 시 "Settings > Secrets" 에 등록할 키 목록 예시
# 1. 네이버 개발자센터 (Naver Developers Open API)
NAVER_CLIENT_ID = "YOUR_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET = "YOUR_NAVER_CLIENT_SECRET"

# 2. 또는 네이버 클라우드 플랫폼 (NCP API Gateway)
NCP_CLIENT_ID = "YOUR_NCP_CLIENT_ID"
NCP_CLIENT_SECRET = "YOUR_NCP_CLIENT_SECRET"
