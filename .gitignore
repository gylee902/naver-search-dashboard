# ==============================================================================
# Git Ignore Configuration for Naver Market Insight & Analytics Dashboard
# ==============================================================================

# ----------------- 1. Environment & Sensitive Credentials -----------------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ----------------- 2. Python Bytecode & Build Artifacts -----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ----------------- 3. Virtual Environments -----------------
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ----------------- 4. Data & Output Reports (Dynamic Results) -----------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
output/reports/*
!output/reports/.gitkeep

# ----------------- 5. Testing & Quality Tools Cache -----------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ----------------- 6. IDE, Editors & OS System Files -----------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
